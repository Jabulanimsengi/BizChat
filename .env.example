NODE_ENV=development
DATABASE_URL=postgresql://bizchat:bizchat@localhost:5432/bizchat?schema=public
REDIS_URL=redis://localhost:6379
# If the default host ports are occupied, set BIZCHAT_POSTGRES_PORT and BIZCHAT_REDIS_PORT and
# update DATABASE_URL / REDIS_URL to match. Container-internal ports remain unchanged.
BIZCHAT_POSTGRES_PORT=5432
BIZCHAT_REDIS_PORT=6379
SESSION_SECRET=replace-with-at-least-32-random-characters
WIDGET_TOKEN_SECRET=replace-with-a-different-32-character-secret
SESSION_TTL_HOURS=168
WIDGET_SESSION_TTL_MINUTES=30
AGENT_PRESENCE_TTL_SECONDS=45
TYPING_TTL_SECONDS=6
RELIABILITY_SWEEP_INTERVAL_MS=5000
QUEUE_ABANDON_AFTER_SECONDS=120
NEW_TENANT_ASSIGNMENT_MODE=OFFER
RELIABILITY_RETRY_BASE_MS=1000
SOCKET_REDIS_ADAPTER_ENABLED=true
API_PORT=4000
APP_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public URL of the built widget bundle used by the dashboard's embed snippet.
NEXT_PUBLIC_WIDGET_URL=http://localhost:4173/widget.js
ALLOWED_DEV_ORIGINS=http://localhost:3000
# Comma-separated proxy IP addresses or CIDR ranges. Leave empty when the API is directly exposed.
TRUSTED_PROXIES=
# Local attachment staging directory. Uploads are validated and scanned before being stored.
ATTACHMENT_STORAGE_PATH=var/attachments
# filesystem | s3. Development may use the filesystem driver; production must use s3.
ATTACHMENT_STORAGE_DRIVER=filesystem
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Allow a plaintext HTTP S3 endpoint (development only).
S3_ALLOW_INSECURE=false
# Enable only for object stores that support SSE-S3 (for example managed AWS S3).
S3_SERVER_SIDE_ENCRYPTION=true
S3_PREFIX=attachments
# clamav | disabled. Development may disable scanning; production must scan.
ATTACHMENT_SCANNER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
# open | closed. In production the API defaults to (and requires) closed.
THROTTLER_FAIL_MODE=open
# Outbound email. Leave SMTP_HOST empty in development to log mail to the console.
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BizChat <no-reply@localhost>
