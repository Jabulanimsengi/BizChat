{
  "name": "@bizchat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "test:http": "jest --config jest-e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "tsx prisma/migrate.ts deploy",
    "db:migrate:deploy": "tsx prisma/migrate.ts deploy",
    "db:migrate:status": "tsx prisma/migrate.ts status",
    "db:migrate:baseline": "tsx prisma/migrate.ts baseline",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@bizchat/types": "*",
    "@bizchat/validation": "*",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "11.2.3",
    "@prisma/client": "^6.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ioredis": "^5.6.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
