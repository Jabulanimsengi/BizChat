# BizChat production environment template.
# Copy to .env, fill in real values from a secret manager, and never commit the result.
# The API refuses to start in production unless every rule below is satisfied.

NODE_ENV=production
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
DATABASE_URL=postgresql://bizchat:${POSTGRES_PASSWORD}@postgres:5432/bizchat?schema=public
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Independent, at least 32 random bytes each: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
WIDGET_TOKEN_SECRET=replace-with-a-different-32-character-secret

# Public HTTPS origins.
APP_URL=https://api.example.com
DASHBOARD_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Public HTTPS URL of the built widget bundle served by your CDN.
NEXT_PUBLIC_WIDGET_URL=https://cdn.example.com/widget.js

# Exact reverse-proxy IPs or CIDR ranges. Never use "*".
TRUSTED_PROXIES=10.0.0.10/32
SOCKET_REDIS_ADAPTER_ENABLED=true
# Production rate limiting must fail closed when Redis is unavailable.
THROTTLER_FAIL_MODE=closed

# Object storage. S3-compatible endpoints (AWS S3, MinIO, Cloudflare R2) are supported.
ATTACHMENT_STORAGE_DRIVER=s3
ATTACHMENT_STORAGE_PATH=/data/staging
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=bizchat-attachments
S3_ACCESS_KEY_ID=replace-with-object-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
S3_FORCE_PATH_STYLE=false
# Set true only when the endpoint is a trusted private/internal service such as the bundled MinIO
# reached over plaintext HTTP. Leave false for managed HTTPS object storage.
S3_ALLOW_INSECURE=false
# Set false when using the bundled MinIO (no KMS); true for managed AWS S3.
S3_SERVER_SIDE_ENCRYPTION=true
S3_PREFIX=attachments

# Malware scanning is mandatory in production.
ATTACHMENT_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Outbound email is required in production (password reset and email verification).
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=BizChat <no-reply@example.com>
