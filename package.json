{
  "name": "bizchat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    },
    "body-parser": {
      "qs": "6.16.0"
    },
    "express": {
      "qs": "6.16.0"
    },
    "superagent": {
      "qs": "6.16.0"
    }
  },
  "scripts": {
    "build": "npm run build:packages && npm run build -w @bizchat/api && npm run build -w @bizchat/web && npm run build -w @bizchat/widget",
    "check": "npm run db:generate && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:packages": "npm run build -w @bizchat/types && npm run build -w @bizchat/validation",
    "dev": "npm run build:packages && concurrently -n api,web,widget -c cyan,magenta,green \"npm run dev -w @bizchat/api\" \"npm run dev -w @bizchat/web\" \"npm run dev -w @bizchat/widget\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov -w @bizchat/api",
    "test:http": "npm run test:http -w @bizchat/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:production": "npm audit --omit=dev --omit=optional --audit-level=high",
    "db:generate": "npm run prisma:generate -w @bizchat/api",
    "db:migrate": "npm run db:migrate:deploy -w @bizchat/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @bizchat/api",
    "db:migrate:status": "npm run db:migrate:status -w @bizchat/api",
    "db:migrate:baseline": "npm run db:migrate:baseline -w @bizchat/api",
    "db:seed": "npm run prisma:seed -w @bizchat/api",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:stack:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:stack:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "e2e": "node tools/run-e2e.mjs",
    "e2e:backup-restore": "node tools/backup-restore-test.mjs",
    "smoke:production": "node tools/production-smoke.mjs",
    "backup": "node tools/backup.mjs",
    "restore": "node tools/restore.mjs",
    "release:manifest": "node tools/release-manifest.mjs"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "rxjs": "7.8.2"
  }
}
